# Ignore everything in the folder by default
*
# But don't ignore directories (so we can traverse them)
!*/

# Track specific Python files and configs
!*.py
!.gitignore
!README.md
!sfx/
!music/
!music/*.json
!.agents/
!.agents/**

# Explictly ignore generated and heavy folders (just to be safe)
english_long_assets/
hindi_long_assets/
english_short_assets/
hindi_short_assets/
output/
music/*.mp3
music/*.wav
sfx/*.mp3
sfx/*.wav
Flow_Prototype/
__pycache__/
.idea/
.venv/
*.ipynb
